# === サーバー ===
PORT=8080
# ログファイルパス (stdout にも同時出力)
LOG_PATH=logs/app.log
# LOG_LEVEL=debug

# === LLM ===
# stub: キーワードベースの固定応答 / chat: OpenAI Chat Completion API
LLM_MODE=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# === TTS ===
# エンジン: piper / voicevox
TTS_ENGINE=piper

# --- Piper Plus 設定 ---
TTS_URL=http://tts:5000
TTS_VOICE=tsukuyomi_mb
TTS_SPEAKER_ID=0
TTS_LANGUAGE=ja
# 話速 (大きいほどゆっくり)
TTS_LENGTH_SCALE=1.3
# 声質のばらつき (0.0-1.0)
TTS_NOISE_SCALE=0.667
# 発音のゆらぎ (0.0-1.0)
TTS_NOISE_W=0.8

# --- VOICEVOX 設定 ---
VOICEVOX_URL=http://voicevox:50021
# 話者ID (0:四国めたん, 1:ずんだもん, 2:春日部つむぎ, 3:雨晴はう, ...)
VOICEVOX_SPEAKER_ID=3
# 話速 (1.0が標準)
VOICEVOX_SPEED_SCALE=1.0

# === STT (Whisper.cpp) ===
STT_URL=http://stt:8888
# 認識言語 (ja, en, zh, etc.)
STT_LANGUAGE=ja
